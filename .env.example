# Deployment settings. On the VM they come from GitLab CI/CD variables (Settings → CI/CD → Variables);
# locally you can export them. Only the first block is required.

# --- Required ---
POSTGRES_USER=veto
POSTGRES_PASSWORD=change-me
POSTGRES_DB=veto

# --- Optional ---
# Public address used in password-reset links, e.g. http://203.0.113.10
PUBLIC_URL=
# auto = Secure cookie only over HTTPS (correct for the current HTTP-only VM)
COOKIE_SECURE=auto
# Password recovery and support e-mail copies (disabled while SMTP_HOST is empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=VETO <no-reply@veto.app>
SUPPORT_EMAIL=support@veto.app
# Better photos for generic ideas (Wikimedia works without keys)
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
# Web Push needs HTTPS; over plain HTTP the in-app notification centre is used
VAPID_SUBJECT=mailto:support@veto.app
