{
 "title": "VETO — обзор",
 "uid": "veto-overview",
 "schemaVersion": 39,
 "refresh": "10s",
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "title": "Запросов в секунду",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "expr": "sum(rate(veto_http_requests_total[1m]))",
     "legendFormat": "rps",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   }
  },
  {
   "id": 2,
   "title": "Доля ошибок 5xx",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 6,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "expr": "sum(rate(veto_http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(veto_http_requests_total[5m])),0.001)",
     "legendFormat": "5xx",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   }
  },
  {
   "id": 3,
   "title": "p95 задержки",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum by (le) (rate(veto_http_request_duration_seconds_bucket[5m])))",
     "legendFormat": "p95",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   }
  },
  {
   "id": 4,
   "title": "Открытых live-подключений (SSE)",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 18,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "expr": "veto_sse_connections",
     "legendFormat": "sse",
     "refId": "A"
    }
   ]
  },
  {
   "id": 5,
   "title": "RPS по маршрутам",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 9
   },
   "targets": [
    {
     "expr": "sum by (route) (rate(veto_http_requests_total[1m]))",
     "legendFormat": "{{route}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   }
  },
  {
   "id": 6,
   "title": "p95 по маршрутам",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 9
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum by (le, route) (rate(veto_http_request_duration_seconds_bucket[5m])))",
     "legendFormat": "{{route}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   }
  },
  {
   "id": 7,
   "title": "Бизнес-события",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 13,
    "w": 12,
    "h": 9
   },
   "targets": [
    {
     "expr": "sum by (event) (increase(veto_domain_events_total[15m]))",
     "legendFormat": "{{event}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 8,
   "title": "Ответы по статусам",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 13,
    "w": 12,
    "h": 9
   },
   "targets": [
    {
     "expr": "sum by (status) (rate(veto_http_requests_total[1m]))",
     "legendFormat": "{{status}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 9,
   "title": "Web Push",
   "type": "bargauge",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 22,
    "w": 12,
    "h": 6
   },
   "targets": [
    {
     "expr": "sum by (result) (increase(veto_push_sent_total[1h]))",
     "legendFormat": "{{result}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 10,
   "title": "Необработанные ошибки",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 22,
    "w": 12,
    "h": 6
   },
   "targets": [
    {
     "expr": "increase(veto_unhandled_errors_total[1h])",
     "legendFormat": "errors",
     "refId": "A"
    }
   ]
  }
 ]
}